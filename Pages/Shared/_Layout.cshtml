<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Pilot Aptitude</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="topbar">
            <a class="brand" asp-page="/Index">
                <span class="brand-mark" aria-hidden="true"></span>
                <span class="brand-text">PILOT APTITUDE</span>
            </a>
            <nav class="topnav">
                <a asp-page="/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">Home</a>
                <a asp-page="/Memory" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Memory" ? "active" : "")">Memory</a>
                <a asp-page="/Control" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Control" ? "active" : "")">Control</a>
                <a asp-page="/Results" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Results" ? "active" : "")">Results</a>
            </nav>
        </header>

        <main class="main-stage">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>COMPASS™-inspired screening · Hackathon build</span>
            <span>Desktop &amp; tablet ready</span>
        </footer>
    </div>

    <script src="~/js/scoring.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
