@page
@model PilotAptitude.Pages.ControlModel
@{
    ViewData["Title"] = "Control";
}

<section class="panel">
    <div class="panel-header">
        <div>
            <h1>CONTROL</h1>
            <p>Compensatory tracking — keep the ball on the red mark against continuous drift.</p>
        </div>
        <div class="mode-toggle" id="modeToggle">
            <button type="button" data-mode="practice" class="active">Practice</button>
            <button type="button" data-mode="assessment">Assessment</button>
        </div>
    </div>

    <p class="instructions">
        Use arrow keys or WASD to counter turbulence. Mouse drag / touch also works.
        Practice runs 45s; assessment runs 75s with stronger drift.
    </p>

    <div class="status-bar">
        <div class="stat-chip"><span class="label">Time left</span><span class="value" id="statTime">—</span></div>
        <div class="stat-chip"><span class="label">On target</span><span class="value" id="statOnTarget">0%</span></div>
        <div class="stat-chip"><span class="label">Mean |dev|</span><span class="value" id="statDev">—</span></div>
        <div class="stat-chip"><span class="label">Corrections</span><span class="value" id="statCorr">0</span></div>
    </div>

    <div class="control-layout">
        <div class="instrument-frame">
            <canvas id="controlCanvas" width="480" height="420" aria-label="Compensatory tracking instrument"></canvas>
        </div>
        <aside class="control-side">
            <div class="panel" style="box-shadow:none;padding:1rem;">
                <strong style="font-family:var(--font-display);letter-spacing:0.08em;">INPUT</strong>
                <p class="instructions" style="margin-top:0.5rem;">Keyboard preferred for precision.</p>
                <div class="keys-hint" aria-hidden="true">
                    <span></span><span class="keycap">W</span><span></span>
                    <span class="keycap">A</span><span class="keycap">S</span><span class="keycap">D</span>
                    <span class="keycap wide">← ↑ ↓ →</span>
                </div>
            </div>
            <div class="cta-row">
                <button class="btn btn-primary" id="btnStart">Start run</button>
                <button class="btn btn-ghost" id="btnStop" disabled>Abort</button>
            </div>
            <div class="feedback" id="feedback"></div>
            <div class="cta-row hidden" id="endRow">
                <a class="btn btn-primary" asp-page="/Results">Open results</a>
                <button class="btn btn-ghost" id="btnRestart">Run again</button>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/js/control.js" asp-append-version="true"></script>
}
